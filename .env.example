# =============================================================================
# Nanoclaw — example environment (safe to commit). Copy to `.env` and fill secrets.
# =============================================================================
#
# Conventions (reduces merge corruption when tools append lines):
#   1) Secrets / keys only in the secrets block below (leave values blank here).
#   2) Prefer adding new non-secret tuning at the BOTTOM block marked “Append”.
#   3) RPC policy and ROI baseline: see docs/ENV_RPC.md
#
# Grok / stage policy — prefer these exact key names.
# Some legacy aliases are still read for backward compatibility and are documented below.
#   COPY_TRADE_PCT=0.32   TAKE_PROFIT_PCT=5.0   STRONG_SIGNAL_TP=12.0
#   X_SIGNAL_STRONG_THRESHOLD=0.80   X_SIGNAL_FORCE_*_THRESHOLD=0.80
#   Fixed $12–$20 per-signal sizing: runtime.fixed_copy_trade_usd (+ COPY_TRADE_PCT), not
#   COPY_TRADE_SIZE_USD / MAX_TRADE_SIZE_USD (those names are not read).
#
# Sync from a live VM `.env` without secrets (review diff before commit):
#   python scripts/nanoenv_example.py --write
#   git diff .env.example
# Verify template drift + config coverage:
#   python scripts/verify_env_example_keys.py
#
# =============================================================================

# --- Secrets (never commit real values) ---
# Wallet signing key (preferred: POLYGON_PRIVATE_KEY): single line, ``0x`` + 64 hex (or 64 hex only).
# No quotes; avoid trailing newline (trimmed at runtime, but a clean line prevents startup failures).
# Legacy alias PRIVATE_KEY is still read as fallback for backward compatibility.
POLYGON_PRIVATE_KEY=
PRIVATE_KEY=
# --- Optional integrations (empty value = feature off unless noted) ---
NANOCLAW_GROK_ENABLED=false
GROK_API_KEY=
XAI_API_KEY=
GROK_API_BASE=https://api.x.ai/v1
GROK_MODEL=grok-2-latest
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional 1inch quotes (swap_executor) ---
ONEINCH_API_KEY=
INCH_API_KEY=

# --- RPC (details: docs/ENV_RPC.md) ---
# Use this as the single primary setting (comma-separated, in priority order).
# The bot tries each endpoint before falling back to stale/manual balances.
# Use real working RPC URLs only; never keep placeholder text in VM runtime env.
# Put a paid or project-scoped URL first on the VM only; do not commit real tokens.
# If `ANKR_RPC_KEY` is set in `.env`, python-dotenv expands `${ANKR_RPC_KEY}` below (place that key above this line on the VM).
ANKR_RPC_KEY=
RPC_ENDPOINTS=https://rpc.ankr.com/polygon/${ANKR_RPC_KEY},https://polygon-rpc.com,https://polygon.drpc.org
# Legacy compatibility keys (optional). Leave empty unless a tool specifically needs them.
RPC=
RPC_URL=
WEB3_PROVIDER_URI=
# Optional extra gas/POL probe endpoints (usually keep empty).
RPC_FALLBACKS=

# --- Public wallet & Polygon contracts ---
# Stage/production address: set once in VM `.env`; `nanoup` preserves it (not overwritten from this template line).
WALLET=0x05eF62F48Cf339AA003F1a42E4CbD622FFa1FBe6
USDT=0xc2132D05D31c914a87C6611C10748AEb04B58e8F
# USDC.e (bridged) — swaps/router paths typically use this on Polygon PoS.
USDC=0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174
# Native USDC (Circle) — separate ERC-20; include so STABLE_USD / portfolio totals match wallet UI.
USDC_NATIVE=0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359
WMATIC=0x0d500B1d8E8eF31E21C99d1Db9A6444d3ADf1270
ROUTER=0xa5E0829CaCEd8fFDD4De3c43696c57F7D7A678ff
QUICKSWAP_V2_ROUTER=0xa5E0829CaCEd8fFDD4De3c43696c57F7D7A678ff
UNISWAP_V3_SWAP_ROUTER=0xE592427A0AEce92De3Edee1F18E0157C05861564
UNISWAP_V3_QUOTER=0xb27308f9F90D607463bb33eA1BeBb41C27CE5AB6
# QuoterV2 (Polygon/mainnet); FE_USD inventory MTM tries this after V2-router, often succeeds when legacy Quoter reverts.
UNISWAP_V3_QUOTER_V2=0x61fFE014bA17989E743c5F6cB21bF9697530B21e

LOG_PREFIX=[nanoclaw-av]

# --- ABI paths (defaults are in-repo) ---
ERC20_ABI_PATH=nanoclaw/abi/erc20.json
ROUTER_ABI_PATH=nanoclaw/abi/router_swap_exact_tokens_for_tokens.json
GET_AMOUNTS_OUT_ABI_PATH=nanoclaw/abi/router_get_amounts_out.json

# --- Gas & POL ---
POL_USD_PRICE=0.10
# Floor for POL (native) before AUTO-POL tries USDT→WMATIC / WMATIC unwrap.
# DO NOT use 0.005 on stage — AUTO-POL skips until swaps fail on gas. nanoup applies this from template.
# Default 0.15 targets ~0.15–0.20 POL reserve (native units, not USD).
MIN_POL_FOR_GAS=0.15
AUTO_TOPUP_POL=true
POL_TOPUP_AMOUNT=0.03
POL_AUTO_TOPUP_COOLDOWN_SECONDS=300
# Minimum POL to broadcast unwrap/swap legs; below this, send native POL manually once.
POL_MIN_BALANCE_FOR_TOPUP_TX=0.006
# Dynamic reserve: AUTO-POL fires when POL < max(MIN_POL_FOR_GAS, swap_gas × urgent_gwei × multiplier).
POL_SWAP_GAS_UNITS=450000
# Approve + swap gas budget for pre-trade POL top-up (must be >= POL_SWAP_GAS_UNITS reserve).
POL_EXECUTION_GAS_UNITS=600000
POL_EXECUTION_GAS_MULTIPLIER=1.15
POL_APPROVE_GAS_UNITS=85000
POL_UNWRAP_GAS_UNITS=140000
POL_GAS_RESERVE_MULTIPLIER=1.30
POL_GAS_RESERVE_BUFFER_POL=0.005
FORCE_STARTUP_MAX_APPROVE=true
# Max network gas price (gwei) for guards used by swaps and AUTO-USDC. Stage VMs often need
# 130–150+ during congestion; 80 blocks AUTO-USDC and swaps when live gas is higher.
MAX_GWEI=250
URGENT_GWEI=120
GAS_RPC_RETRY_ATTEMPTS=2

# --- Global timing (Grok “180s” global cooldown → minutes) ---
# Stage VM currently may use: COOLDOWN_MINUTES=2
COOLDOWN_MINUTES=1
# Overlap guard while approve+swap runs (default 300s; was 15s and allowed parallel cron loss-cuts).
NANOCLOW_CYCLE_LOCK_SECONDS=300
PER_ASSET_COOLDOWN_MINUTES=20
TEST_MODE=false

# --- Copy / main strategy levers (stage policy) ---
# Wallet list: followed_wallets.json (EOA traders only). Audit: nanocopyaudit
# Safe stage default: false until followed_wallets.json has ≥1 verified trader EOA (nanocopyaudit exit 0).
COPY_TRADING_ENABLED=false
# Reject USDC/WMATIC/etc. token addresses mistakenly listed as "wallets" (default safe).
COPY_TRADING_REJECT_TOKEN_CONTRACTS=true
COPY_TRADE_PCT=0.32
COPY_RATIO=0.32
PER_WALLET_COOLDOWN=180

# --- Take-profit & exits ---
TRAILING_STOP_PCT=5.0
TAKE_PROFIT_PCT=6.0
# Min estimated net edge (% of notional after fee buffer + gas) for X-Signal / main entry trades (conservative v1; 1.5–2% typical).
MIN_NET_EDGE_PCT=2.0
# Reserve % of notional for swap fee/slippage before gas in net-edge planning.
# MIN_NET_EDGE_FEE_BUFFER_PCT=0.75
# Planning gas (gwei) for early net-edge gates in determine_trade_decision (no RPC); main() uses live gas.
# NET_EDGE_PLANNING_GAS_GWEI=120
# Main USDT→WMATIC: gross edge = TAKE_PROFIT_PCT × frac when MAIN_STRATEGY_ENTRY_EDGE_PCT=0.
# MAIN_STRATEGY_ENTRY_EDGE_FRAC=0.70
# MAIN_STRATEGY_ENTRY_EDGE_PCT=0
STRONG_SIGNAL_TP=12.0
TAKE_PROFIT_SELL_PCT=0.45
STRONG_TP_SELL_PCT=0.60

# --- USDC copy strategy ---
ENABLE_USDC_COPY=true
USDC_COPY_MIN_TRADE=8.0
USDC_COPY_MAX_TRADE=25.0
COPY_BASE_EXPECTED_EDGE_PCT=4.5
COPY_GAS_EDGE_MULTIPLIER=1.9
COPY_MIN_EFFECTIVE_TRADE_AFTER_GAS_USD=10.0
COPY_MIN_MARGINAL_TRADE_USD=12.0
COPY_WALLET_PERFORMANCE_FILE=wallet_performance.json
COPY_WALLET_PERFORMANCE_WINDOW_TRADES=25
COPY_WALLET_PERFORMANCE_MIN_TRADES=8
COPY_WALLET_PERFORMANCE_POOR_WINRATE=0.40
COPY_WALLET_PERFORMANCE_POOR_AVG_PNL_USD=-0.20
COPY_WALLET_PERFORMANCE_PENALTY_MULTIPLIER=0.65

# --- X-Signal equity ---
ENABLE_X_SIGNAL_EQUITY=true
FOLLOWED_EQUITIES_PATH=followed_equities.json
X_SIGNAL_EQUITY_MIN_STRENGTH=0.52
X_SIGNAL_STRONG_THRESHOLD=0.80
# Cycle precedence / main deferral only (defaults to X_SIGNAL_STRONG_THRESHOLD — lower to rotate earlier).
X_SIGNAL_ROTATION_PRIORITY_THRESHOLD=
# When >0: force-eligible BUY also triggers rotation if upside_pct meets this (strength bar unchanged).
X_SIGNAL_ROTATION_MIN_UPSIDE_PCT=0
# Optional noise filter (0=off): drop non-force-eligible below strength / upside.
X_SIGNAL_MIN_ACTIONABLE_STRENGTH=0
X_SIGNAL_MIN_UPSIDE_PCT_FOR_WEAK=0
# Optional compatibility alias used by config fallback:
# if set, this seeds X_SIGNAL_* high-conviction thresholds.
HIGH_CONVICTION_THRESHOLD=0.80
X_SIGNAL_MAX_EARNINGS_DAYS=5.0
X_SIGNAL_FORCE_ELIGIBLE_THRESHOLD=0.80
X_SIGNAL_FORCE_HIGH_CONVICTION_THRESHOLD=0.80
X_SIGNAL_FORCE_HIGH_CONVICTION=true
X_SIGNAL_HIGH_CONVICTION_PREP_MIN_USDC=8.0
X_SIGNAL_HIGH_CONVICTION_PREP_MIN_WMATIC=12.0
X_SIGNAL_DYNAMIC_TIER_HIGH_MIN=0.90
X_SIGNAL_DYNAMIC_USDC_GTE_TIER_HIGH=20.0
X_SIGNAL_DYNAMIC_USDC_GTE_FORCE_ELIGIBLE=15.0
X_SIGNAL_DYNAMIC_USDC_BELOW_FORCE_ELIGIBLE=12.0
X_SIGNAL_EQUITY_COOLDOWN_FIRST_SORT=true
X_SIGNAL_EQUITY_COOLDOWN_SECONDS=
X_SIGNAL_EQUITY_STRONG_TP_PCT=12.0
X_SIGNAL_EQUITY_SELL_FRACTION=0.55
X_SIGNAL_EQUITY_TRADE_PCT=0.18
X_SIGNAL_EQUITY_MAX_TRADE=28.0
X_SIGNAL_EQUITY_MIN_TRADE=
# X-SIGNAL-only: when USDT+USDC ≥ ~$80, dust defer + hard bypass use min(MIN_TRADE_USD, this) (reversible travel tune).
X_SIGNAL_EQUITY_DUST_MIN_USD=7.5
# Optional comma-separated skip list (balance-read workaround). Leave empty to trade all assets.
X_SIGNAL_TEMP_SKIP_SYMBOLS=
# When true, blocking every followed asset in .xsignal_blocked_symbols stops X-SIGNAL equity
# (no "ignoring blocks this cycle" bypass). Default false preserves legacy behavior.
X_SIGNAL_HONOR_FULL_BLOCKLIST=false
# TEMPORARY (May 2026): WBTC_* BUY min notional while Polygon WBTC liquidity is poor; 0 disables.
# Lowered 25.0 -> 10.0 (May 2026): default X-SIGNAL sizing is ~$10.25 on small bankrolls,
# so $25 blocked WBTC 100%. Realized-slippage ceiling is the actual safety net at this size.
X_SIGNAL_WBTC_MIN_NOTIONAL_USD=10.0
# USDC fragmentation safety margin (bps) shaved off best per-variant USDC balance when capping
# the X-SIGNAL trade size. The swap layer can only spend from one ERC20 contract, so trade size
# is capped to max(per-variant USDC) * (1 - eps); below min_trade_usdc -> skip with reason
# `insufficient_per_variant_usdc`. Default 50 (= 0.5%).
X_SIGNAL_PER_VARIANT_USDC_EPS_BPS=50
X_SIGNAL_USDC_MIN=5.0
X_SIGNAL_WMATIC_MIN_VALUE=15.0
AUTO_POPULATE_USDC_AMOUNT=20.0
AUTO_USDC_FOR_X_SIGNAL_MIN_USDC=5.0
AUTO_USDC_FOR_X_SIGNAL_MIN_WMATIC_VALUE=15.0
X_SIGNAL_USDC_SAFE_FLOOR=22.0
# Cap effective-size gate when USDC < safe floor (aligns with ~$10 dynamic X-SIGNAL sizing).
X_SIGNAL_LIMITED_USDC_MIN_EFFECTIVE_GATE_USD=10.0
# Effective-size tiers after gas (USDC→equity BUY): |signal|≥0.85 → base; ≥0.80 → medium; else weak.
X_SIGNAL_MIN_EFFECTIVE_TRADE_USD_BASE=12.0
X_SIGNAL_MIN_EFFECTIVE_TRADE_USD_MEDIUM_TIER=14.0
X_SIGNAL_MIN_EFFECTIVE_TRADE_USD_WEAK_TIER=15.0
# PnL recovery: cap gate at recovery floor while MAIN_STRATEGY_PNL_RECOVERY_MODE or low max_copy_trade_pct.
X_SIGNAL_RECOVERY_EFFECTIVE_GATE_ENABLED=true
X_SIGNAL_RECOVERY_MIN_EFFECTIVE_GATE_USD=9.0
X_SIGNAL_RECOVERY_GAS_BUFFER_USD=1.25
# Relax when control.json max_copy_trade_pct <= threshold (default 6% defensive tier).
X_SIGNAL_RECOVERY_MAX_COPY_PCT_THRESHOLD=0.06
# Relax when control.json stable_usd (USDT+USDC) is below moderate runway (default $100).
X_SIGNAL_RECOVERY_STABLE_USD_MAX=100.0
# Relax when portfolio_history total is below portfolio_session_baseline.json.
X_SIGNAL_RECOVERY_SESSION_PNL_ENABLED=true
X_SIGNAL_AUTO_USDC_TARGET=28.0
X_SIGNAL_AUTO_USDC_TOPUP_ENABLED=true
# Stage liveness: lower floor/target/min-swap only while diagnosing BUY paths; keep template conservative.
X_SIGNAL_AUTO_USDC_MIN_SWAP_USD=8.0
# Cooldown after unchanged failed AUTO-USDC attempt (reduces repeated zero_usdc retry loops).
X_SIGNAL_AUTO_USDC_FAIL_COOLDOWN_SECONDS=180
# On-chain USDC read retries per RPC endpoint (minimum effective attempts = 2).
X_SIGNAL_ONCHAIN_USDC_RETRY_ATTEMPTS=2

# --- Swaps ---
# IMPORTANT: slippage is in basis points (bps), not percent.
# Example: 0.8% = 80 bps.
SWAP_SLIPPAGE_BPS=100
# Slippage (bps) for read-only FE_USD / inventory quotes when V2 router paths fail (Uniswap V3 quoter fallback).
INVENTORY_MTM_SLIPPAGE_BPS=300
# Max upward drift per day for persisted FE_USD last-good spot (requires live quote to raise cache).
FE_USD_SPOT_CACHE_MAX_UP_PCT_PER_DAY=5.0
FALLBACK_ROUTER_SLIPPAGE_BPS=
FALLBACK_ROUTER_RETRY_SLIPPAGE_BPS=
ONCHAIN_SWAP_RETRY_EXTRA_BPS=50
# 1inch endpoints are optional advanced overrides.
ONEINCH_SWAP_ENDPOINT=https://api.1inch.dev/swap/v5.2/137/swap
ONEINCH_SPENDER_ENDPOINT=https://api.1inch.dev/swap/v5.2/137/approve/spender
# Stage VM compatibility names (also read by config.py):
HIGH_CONVICTION_FALLBACK_PRIMARY_BPS=3500
HIGH_CONVICTION_FALLBACK_RETRY_BPS=4500
HIGH_CONVICTION_FALLBACK_SLIPPAGE_BPS=
HIGH_CONVICTION_FALLBACK_RETRY_SLIPPAGE_BPS=
# Small high-conviction X-SIGNAL only (USDC_TO_EQUITY, notional<=$12); fallback router.
# |signal| threshold: X_SIGNAL_SMALL_GATED_MIN_STRENGTH (default 0.80) when notional <= X_SIGNAL_SMALL_GATED_MAX_NOTIONAL_USD (12).
X_SIGNAL_SMALL_GATED_MIN_STRENGTH=0.80
X_SIGNAL_SMALL_GATED_MAX_NOTIONAL_USD=12.0
# Legacy name: |signal|>=0.85 for larger notionals still uses small tier when notional <= $12.
# Tightened 8000/10000 -> 3000/5000 bps (May 2026): V3 pre-flight `check=ok` already validates
# the quote; 100% fill at 8000 bps proved realized slippage was tiny. New ceiling cuts
# worst-case ~$8 -> ~$3 on a $10 trade with 5x safety margin over typical V3 fills.
X_SIGNAL_SMALL_HIGH_CONVICTION_FALLBACK_PRIMARY_BPS=3000
X_SIGNAL_SMALL_HIGH_CONVICTION_FALLBACK_RETRY_BPS=5000
# Signal-driven execution quality (May 2026): X-SIGNAL gated USDC→equity (fallback router only)
X_SIGNAL_GATED_TRADE_FALLBACK_PRIMARY_BPS=9500
X_SIGNAL_GATED_TRADE_FALLBACK_RETRY_BPS=12500
X_SIGNAL_GATED_TRADE_MIN_OUT_EXTRA_BPS=100
X_SIGNAL_HIGH_CONVICTION_MIN_OUT_EXTRA_BPS=25
X_SIGNAL_SMALL_HIGH_CONVICTION_MIN_OUT_EXTRA_BPS=50
# Pause asset after N STF reverts on X-SIGNAL USDC→equity (same wallet)
X_SIGNAL_STF_PAUSE_AFTER_FAILURES=2
X_SIGNAL_STF_PAUSE_SECONDS=3600
# Escalate long pause duration on each repeated STF pause cycle (cap below)
X_SIGNAL_STF_PAUSE_ESCALATION_MULTIPLIER=2.0
X_SIGNAL_STF_MAX_PAUSE_SECONDS=14400
# Short per-asset cooldown after each STF (before long pause at STF_PAUSE_AFTER_FAILURES)
X_SIGNAL_STF_FAILURE_COOLDOWN_SECONDS=600
# Pre-flight before X-SIGNAL fallback submit: max quote age (s) and max eth_estimateGas
X_SIGNAL_PREFLIGHT_MAX_QUOTE_AGE_SECONDS=8.0
X_SIGNAL_PREFLIGHT_MAX_GAS_LIMIT=650000
# |signal|>=0.90: first ramp step = tier primary minus this (conservative first attempt)
X_SIGNAL_HIGH_CONVICTION_PRIMARY_RELIEF_BPS=800
# Wait before re-quoting on X-SIGNAL fallback retry (seconds)
X_SIGNAL_FALLBACK_REQUOTE_DELAY_SECONDS=1.5
# Prefer 0.3% V3 pool when within this many bps of best quote (stabler equity path)
X_SIGNAL_STABLE_FEE_PREFER_BPS=75
# X-SIGNAL quoting: QuoterV2 before legacy QuoterV1; V2 router multihop when V3 single-hop missing.
X_SIGNAL_QUOTE_PREFER_QUOTER_V2=true
X_SIGNAL_V2_ROUTER_FALLBACK_ENABLED=true
# Raw USDC amount (6 decimals) below which fee tiers are probed 3000→500→10000 first.
X_SIGNAL_SMALL_TRADE_USDC_RAW=15000000
# Default X-SIGNAL fallback when gated/small tiers do not apply
X_SIGNAL_DEFAULT_FALLBACK_PRIMARY_BPS=7000
X_SIGNAL_DEFAULT_FALLBACK_RETRY_BPS=11000
X_SIGNAL_DEFAULT_MIN_OUT_EXTRA_BPS=75
# When buffer risk=HIGH but total portfolio > $130 and signal >= 0.80: 0.40x BUY sizing + skip defensive_pause.
ALLOW_REDUCED_HIGH_RISK_XSIGNAL=true

# --- Logging hooks ---
NANOCLAW_TRADE_ATTRIBUTION=true
NO_COLOR=
NANOCLAW_AGENT_LAYER_ENABLED=false
NANOCLAW_TELEMETRY_TELEGRAM=false
NANOCLAW_AGENT_CAN_OVERRIDE_SWAP=false
NANOCLAW_AGENT_LAYER_ADVISORY=false

# --- ROI / PnL baseline (nanostatus/nanopnl, modules/baseline.py) ---
# 0 = automatic (same as empty): portfolio_baseline.json → CSV first row → live total.
# Set a positive USD value only to pin “starting capital” for return % labels.
PORTFOLIO_BASELINE_USD=0

# --- Safe VM update flow (scripts/nanoup.sh) ---
# 0 (default): fail fast on dirty tree before pull.
# 1: auto-stash local changes, pull fast-forward, then apply stash.
NANOUP_AUTOSTASH=0

# =============================================================================
# Append new non-secret tuning here (agents / brainstorm).
# =============================================================================

# --- Fixed per-signal USD band (runtime.fixed_copy_trade_usd + X-signal dynamic interpolate) ---
# Global hard minimum notional for stable-in BUY legs (execution guard).
# SignalEquityTrader also uses this for hard bypass (skip BUY plans below this USD amount).
# Stage liveness: keep FIXED band >= MIN_TRADE_USD to avoid repeated min-trade skips in buy paths.
MIN_TRADE_USD=10
# Legacy alias still read as fallback only when MIN_TRADE_USD is unset.
# Empty value is safe (config falls back to default).
MIN_TRADE_USDC=15
FIXED_TRADE_USD_MIN=6.5
FIXED_TRADE_USD_MAX=10

# Post 4 May 2026 hardening
HARD_BYPASS_ENABLED=true

# --- Compatibility mapping (to avoid silent no-op keys) ---
# These legacy names are READ:
# - MIN_TRADE_USDC -> fallback for MIN_TRADE_USD
# - HIGH_CONVICTION_FALLBACK_SLIPPAGE_BPS -> fallback for HIGH_CONVICTION_FALLBACK_PRIMARY_BPS
# - HIGH_CONVICTION_FALLBACK_RETRY_SLIPPAGE_BPS -> fallback for HIGH_CONVICTION_FALLBACK_RETRY_BPS
#
# These names are NOT read by code (do not rely on them):
# - FLUCTUATION_THRESHOLD      (use PROTECTION_FLUCTUATION_USDT_THRESHOLD)
# - PROTECTION_COOLDOWN_MIN    (use PROTECTION_FLUCTUATION_COOLDOWN_SECONDS)
# - SLIPPAGE_TOLERANCE         (use SWAP_SLIPPAGE_BPS)
# - MAX_TRADES_PER_HOUR        (not implemented; use cooldown controls)

# --- WMATIC↔USDT main strategy (modules.swap_executor.select_main_strategy_trade) ---
# Stage liveness: if cut-loss emits sub-min exits, lower this in `.env`/template so the branch does not dust-loop.
MAIN_STRATEGY_MIN_USDT_RESERVE=25
MAIN_STRATEGY_TP_TRIGGER_WMATIC_USD=52
MAIN_STRATEGY_CUT_LOSS_WMATIC_USD=40
MAIN_STRATEGY_CUT_LOSS_MIN_WMATIC_BALANCE=50
MAIN_STRATEGY_RESERVE_SELL_FRACTION=0.45
MAIN_STRATEGY_CUT_LOSS_SELL_FRACTION=0.28
# Anti-churn: defer USDT→WMATIC after WMATIC→stable exits / when WMATIC stack is large enough.
# TEMPORARY PnL recovery (May 2026): was 6 / 22 — revert once total > $110 and stables healthy.
MAIN_STRATEGY_ACCUMULATE_COOLDOWN_CYCLES=8
MAIN_STRATEGY_ACCUMULATE_MAX_WMATIC_USD=18
# PnL recovery (May 2026): block sub-$8 idle micro-rotations; set false when portfolio stabilizes.
MAIN_STRATEGY_PNL_RECOVERY_MODE=true
MAIN_STRATEGY_PNL_RECOVERY_IDLE_MIN_NOTIONAL_USD=8.0
# Recovery: long-idle / force-small floor (replaces $1.35 micro path) and extra idle cycles.
MAIN_STRATEGY_PNL_RECOVERY_ROTATION_MIN_NOTIONAL_USD=8.0
MAIN_STRATEGY_PNL_RECOVERY_LONG_IDLE_CYCLE_BONUS=3
MAIN_STRATEGY_RECOVERY_MAX_COPY_PCT_THRESHOLD=0.06
# Optional alias: set true to force X-SIGNAL recovery gate without main-strategy idle guard.
PNL_RECOVERY_MODE=false
# Rotation / gas-protection floors (P2, force, idle, dust defer — modules.swap_executor)
MAIN_STRATEGY_ROTATION_MIN_NOTIONAL_USD=8
MAIN_STRATEGY_LOW_ROTATION_MIN_NOTIONAL_USD=10
MAIN_STRATEGY_MODERATE_ROTATION_MIN_NOTIONAL_USD=10
MAIN_STRATEGY_LONG_IDLE_NOTIONAL_FLOOR_USD=1.35
MAIN_STRATEGY_P2_WM_MIN_USD=7
MAIN_STRATEGY_P2_SIGNAL_MIN=0.55
MAIN_STRATEGY_FORCE_WM_MIN_USD=5.5
MAIN_STRATEGY_FORCE_CYCLES_MIN=4
MAIN_STRATEGY_FORCE_NOTIONAL_FLOOR_USD=8
MAIN_STRATEGY_LOW_WM_USD_THRESHOLD=7
MAIN_STRATEGY_MODERATE_WM_USD_THRESHOLD=15
MAIN_STRATEGY_LOW_P2_WM_MIN_USD=5
MAIN_STRATEGY_LOW_P2_SIGNAL_MIN=0.45
MAIN_STRATEGY_LOW_FORCE_WM_MIN_USD=5
MAIN_STRATEGY_LOW_FORCE_CYCLES_MIN=5
MAIN_STRATEGY_MODERATE_P2_WM_MIN_USD=12
MAIN_STRATEGY_MODERATE_P2_SIGNAL_MIN=0.50
MAIN_STRATEGY_MODERATE_FORCE_WM_MIN_USD=12
MAIN_STRATEGY_MODERATE_FORCE_CYCLES_MIN=5
MAIN_STRATEGY_DUST_DEFER_NOTIONAL_USD=8
# Low-stables exception: sub-$8 WMATIC→stable main exits when combined stables < $15 and portfolio > $130.
MAIN_STRATEGY_LOW_STABLES_DUST_REBUILD_ENABLED=true
MAIN_STRATEGY_LOW_STABLES_DUST_REBUILD_MAX_STABLE_USD=15
MAIN_STRATEGY_LOW_STABLES_DUST_REBUILD_MIN_PORTFOLIO_USD=130
MAIN_STRATEGY_LOW_STABLES_DUST_REBUILD_NOTIONAL_FLOOR_USD=5
MAIN_STRATEGY_LOW_STABLES_DUST_REBUILD_CYCLE_COOLDOWN=3
# Prefer WMATIC→USDC (not USDT) when rebuilding stables below the X-SIGNAL high buffer (~$15).
MAIN_STRATEGY_RESERVE_PREFER_USDC=true
# FE-heavy + low stables (WMATIC=0): partial EQUITY→USDC trim before USDC→EQUITY BUY (Cleanup #6).
FE_STABLE_RUNWAY_ENABLED=true
FE_STABLE_RUNWAY_MIN_FE_SHARE=0.55
FE_STABLE_RUNWAY_TARGET_STABLE_USD=40
# Operating reserve — defer new entries when stables < seed × pct (gas + RPC/hosting buffer).
OPERATING_RESERVE_ENABLED=true
OPERATING_RESERVE_PCT=10
# Set on VM to session seed (e.g. 132); 0 = use live TOTAL each cycle.
STAGE_SEED_USD=0

# External layer auto pause/unpause (control.json every ~30s when external_layer runs).
# When true: no manual control.json edits — gates in scripts/nano_green.py drive paused.
EXTERNAL_AUTO_PAUSE_ENABLED=false
EXTERNAL_AUTO_GREEN_HOURS=12
EXTERNAL_AUTO_SESSION_MIN_PCT=-1.0
EXTERNAL_AUTO_WINDOW_MIN_PCT=-2.0
# Floor for 0.40x HIGH-risk X-SIGNAL BUYs so reduced size still clears MIN_TRADE_USD (~$8).
REDUCED_HIGH_RISK_MIN_TRADE_USD=8
# HIGH-risk loss-cut (Option C): trim underwater symbols (default LINK_ALPHA); block BUYs while underwater.
ALLOW_HIGH_RISK_LOSS_CUT_XSIGNAL=true
HIGH_RISK_LOSS_CUT_MIN_PORTFOLIO_USD=130
HIGH_RISK_LOSS_CUT_LOSS_PCT=3.0
HIGH_RISK_LOSS_CUT_SYMBOLS=LINK_ALPHA
HIGH_RISK_LOSS_CUT_SELL_FRACTION=0.55
HIGH_RISK_LOSS_CUT_BLOCK_BUYS=true
HIGH_RISK_LOSS_CUT_BOOTSTRAP_ENTRY_PREMIUM_PCT=12
HIGH_RISK_LOSS_CUT_WHEN_UNDERWATER_ANY_RISK=true
HIGH_RISK_LOSS_CUT_SPOT_SANITY_MULT=1.35
HIGH_RISK_LOSS_CUT_MIN_EQUITY_USD=10
MAIN_STRATEGY_LONG_IDLE_CYCLES_LOW=3
MAIN_STRATEGY_LONG_IDLE_CYCLES_MODERATE=6
MAIN_STRATEGY_LONG_IDLE_CYCLES_HEALTHY=8
MAIN_STRATEGY_LONG_IDLE_FORCE_WM_MIN_USD=1.5
MAIN_STRATEGY_IDLE_ROTATION_SELL_FRACTION_LOW=0.35
MAIN_STRATEGY_IDLE_ROTATION_NOTIONAL_FLOOR_LOW=1.35
MAIN_STRATEGY_IDLE_ROTATION_SELL_FRACTION_HEALTHY=0.28
MAIN_STRATEGY_MILD_LOSS_ENABLED=true
MAIN_STRATEGY_MILD_LOSS_MAX_NOTIONAL_USD=8
MAIN_STRATEGY_MILD_LOSS_IDLE_GAIN_MIN_PCT=-7
MAIN_STRATEGY_MILD_LOSS_IDLE_GAIN_MAX_PCT=-1
MAIN_STRATEGY_MILD_LOSS_IDLE_WM_MIN_USD=5
MAIN_STRATEGY_MILD_LOSS_IDLE_WM_MAX_USD=10
MAIN_STRATEGY_MILD_LOSS_IDLE_CYCLES_MIN=1
MAIN_STRATEGY_MILD_LOSS_FAST_WM_MIN_QTY=10

# --- Aggressive copy-trade banner when COPY_TRADE_PCT is high ---
COPY_TRADE_AGGRESSIVE_THRESHOLD=0.18

# --- protection.py (no wallet secrets) ---
PROTECTION_MAX_DAILY_LOSS_PCT=15
PROTECTION_MIN_POL_BALANCE=2.0
PROTECTION_MAX_TRADE_SIZE_USD=35
PROTECTION_GAS_MULTIPLIER=1.25
PROTECTION_FLUCTUATION_USDT_THRESHOLD=12
PROTECTION_FLUCTUATION_MIN_WMATIC=200
# Stage liveness: if fluctuation exits defer under MIN_TRADE_USD, raise sell fraction in `.env`/template.
PROTECTION_FLUCTUATION_SELL_FRACTION=0.15
PROTECTION_FLUCTUATION_COOLDOWN_SECONDS=900
PROTECTION_FLUCTUATION_MIN_SELL_USD=8
PROTECTION_PROFIT_LOCK_PERCENT=8

# --- External risk layer (``external_layer/control.py`` process only; not read by nanoclaw cycle) ---
# Streak = consecutive protected evaluations (~30s per poll), not nanoclaw trading cycles.
EXTERNAL_RISK_CRITICAL_STABLE_USD=60
EXTERNAL_RISK_CRITICAL_WMATIC=50
EXTERNAL_RISK_MODERATE_STABLE_USD=100
EXTERNAL_RISK_MODERATE_WMATIC=65
EXTERNAL_RISK_CRITICAL_WMATIC_WHEN_STABLE_OK=10
EXTERNAL_RISK_TRAVEL_STABLE_USD=95
EXTERNAL_RISK_TRAVEL_MIN_COPY_PCT=0.045
EXTERNAL_RISK_TIER_CRITICAL_COPY_PCT=0.02
EXTERNAL_RISK_TIER_MODERATE_COPY_PCT=0.03
EXTERNAL_RISK_TIER_HEALTHY_COPY_PCT=0.06
EXTERNAL_CLAMP_STREAK_EVALS=3
EXTERNAL_CLAMP_DURATION_SEC=600
EXTERNAL_CLAMP_DEQUE_MAXLEN=5
EXTERNAL_CLAMP_ARM_MAX_STABLE_USD=95
EXTERNAL_CLAMP_RECOVERY_STABLE_USD=95
EXTERNAL_CLAMP_HEALTHY_STABLE_USD=100
EXTERNAL_CLAMP_RECOVERY_WMATIC=65
# Travel band: clear streak timer at recovery_stable_usd (default 95) regardless of WMATIC pause.
# When stables >= travel and WMATIC >= this floor, cap can reach travel_release_copy_pct (default 6%).
EXTERNAL_CLAMP_TRAVEL_RECOVERY_WMATIC=28
EXTERNAL_CLAMP_TRAVEL_RELEASE_COPY_PCT=0.06
EXTERNAL_CLAMP_STREAK_FLOOR_PCT=0.02
EXTERNAL_CLAMP_TRAVEL_FLOOR_PCT=0.045
EXTERNAL_CLAMP_MIN_COPY_PCT=0.02
EXTERNAL_CLAMP_MAX_COPY_PCT=0.10

# --- copy_trading.py default when followed_wallets.json is missing ---
DEFAULT_MAX_COPY_RATIO=0.20

# --- Optional: comma-separated addresses for wrong-chain hints in diagnostics (modules.signal) ---
CHAIN_HINT_WRONG_ETH_ADDRESSES=

# --- Optional tokenized-equity placeholders ---
GOOGLON=
MSFTON=
APPLON=
AMZNON=
