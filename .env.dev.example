# =============================================================================
# Nanoclaw — dev/lab overlay (safe to commit). No secrets.
# =============================================================================
#
# Used by scripts/dev_bootstrap.sh on ephemeral lab VMs (V4-play, ~$50 book).
# Full template: .env.example. Secrets: ~/.nanoclaw/secrets.dev.env (never commit).
#
#   cp .env.dev.example .env          # on VM after bootstrap
#   # WALLET + POLYGON_PRIVATE_KEY come from secrets.dev.env merge
#
# See docs/VM_ROLES.md and docs/DEV_ENV.md
# =============================================================================

# --- Role (deploy guards) ---
NANOCLAW_ROLE=dev

# --- Wallet (override in secrets.dev.env; placeholder only here) ---
WALLET=0x0000000000000000000000000000000000000000

# --- Dev book seed (~$50 experimental) ---
STAGE_SEED_USD=50
STAGE_SEED_AUTO_SYNC_ENABLED=false
OPERATING_RESERVE_PCT=10

# --- V4-play gates (lab defaults — see docs/ROTATION_PLAYBOOK.md) ---
EXTERNAL_AUTO_UNPAUSE_REQUIRE_DUAL_WINDOW=true
EXTERNAL_AUTO_UNPAUSE_SHORT_HOURS=8
EXTERNAL_AUTO_GREEN_HOURS=12
EXTERNAL_AUTO_WINDOW_MIN_PCT=-2.0
EXTERNAL_AUTO_SESSION_MIN_PCT=-1.0

PLAY_BUDGET_ENABLED=true
PLAY_BUDGET_MAX_FILLS_PER_UTC_DAY=2
PLAY_BUDGET_TOTAL_USD_CEILING=200

X_SIGNAL_NEGATIVE_WINDOW_CAP_ENABLED=true
X_SIGNAL_NEGATIVE_WINDOW_CAP_HOURS=12
X_SIGNAL_NEGATIVE_WINDOW_MAX_TRADE_USD=10

# --- Lab: start paused until operator unpause after nh + nano12h PASS ---
EXTERNAL_AUTO_PAUSE_ENABLED=false

# --- RPC: set ANKR_RPC_KEY in secrets.dev.env; endpoints expanded at runtime ---
RPC_ENDPOINTS=https://rpc.ankr.com/polygon/${ANKR_RPC_KEY},https://polygon.drpc.org,https://polygon-rpc.com
